# --- V2: deadlines & reconciliation ---
# pg-boss (PostgreSQL-backed job queue, same process as API)
PGBOSS_SCHEMA=pgboss
PGBOSS_POOL_MAX=5
PGBOSS_SHUTDOWN_TIMEOUT_MS=15000
RECONCILIATION_RETRY_LIMIT=12
RECONCILIATION_BATCH_SIZE=5
RECONCILIATION_SWEEP_CRON="*/2 * * * *"
DEADLINE_BATCH_SIZE=20
PICKUP_DEADLINE_MINUTES=120
RECONCILIATION_FIRST_CHECK_MS=45000
RECONCILIATION_BASE_BACKOFF_MS=30000
RECONCILIATION_MAX_BACKOFF_MS=900000
RECONCILIATION_WINDOW_MS=600000
