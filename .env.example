DATABASE_URL="postgresql://foodypop:foodypop@localhost:5433/foodypop?schema=public"
PORT=4000
JWT_SECRET="1234567890qwertyuiopasdfghjklzxcvbnm"
NODE_ENV=development
LOG_LEVEL=info

# --- V2: M-Pesa / Daraja ---
DARAJA_BASE_URL="https://sandbox.safaricom.co.ke"
DARAJA_CONSUMER_KEY=""
DARAJA_CONSUMER_SECRET=""
DARAJA_SHORTCODE=""
DARAJA_PASSKEY=""
